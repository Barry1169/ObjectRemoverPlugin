#
# Keep binaries byte-exact. Without this, a checkout on Windows with core.autocrlf=true
# can rewrite a PDF or an .onnx file and silently corrupt it.
*.pdf  -text
*.png  -text
*.jpg  -text
*.ico  -text
*.onnx -text
*.dll  -text
*.ofx  -text
*.zip  -text

# Source and docs are always LF in the repository; let each platform decide the working copy.
* text=auto
